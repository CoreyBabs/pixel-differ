{
	"$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
	"collections": [
		{ "name": "core", "path": "/home/corey/third-party/Odin/core" },
		{ "name": "vendor", "path": "/home/corey/third-party/Odin/vendor" },
		{ "name": "src", "path": "/home/corey/src/xiv-triple-triad/src" }
		{ "name": "game", "path": "/home/corey/src/xiv-triple-triad/src/game/" },
		{ "name": "clay_odin", "path": "/home/corey/src/xiv-triple-triad/src/clay_odin/" }
		{ "name": "ui", "path": "/home/corey/src/xiv-triple-triad/src/ui/" }
	],
	"enable_format": false,
	"enable_semantic_tokens": false,
	"enable_document_symbols": true,
	"enable_hover": true,
	"enable_snippets": true,
	"enable_rename": true,
	"enable_references": true,
	"enable_procedure_snippet": true,
	"enable_checker_only_saved": true,
	"odin_command": "~/third-party/Odin/odin",
	"profile": "linux_profile",
	"profiles": [
		{ "name": "default", "checker_path": ["./src"]},
		{ "name": "linux_profile", "os": "linux", "checker_path": ["src/main.odin"]},
		{ "name": "windows_profile", "os": "windows", "checker_path": ["src"]}
	]
}
